# Firebase Admin credentials belong only in .env.local. Do not commit live credentials.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Razorpay Test Mode values for local development. Never prefix these with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Set this same secret in Razorpay Dashboard > Webhooks for /api/payments/razorpay/webhook.
RAZORPAY_WEBHOOK_SECRET=

# Gmail account used for admin-triggered event reminder emails. Create a Google
# App Password for this account; do not use the normal Gmail password.
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=ozow pwpu oboj dcia
