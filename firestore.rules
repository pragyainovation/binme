rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isRegisteredForEvent(eventId) {
      return signedIn()
        && exists(/databases/$(database)/documents/eventRegistrations/$(request.auth.uid + "_" + eventId));
    }

    function isEnrolledInCourse(courseId) {
      return signedIn()
        && exists(/databases/$(database)/documents/courseEnrollments/$(request.auth.uid + "_" + courseId));
    }

    function hasActiveCourseAccess(courseId) {
      let enrollment = get(/databases/$(database)/documents/courseEnrollments/$(request.auth.uid + "_" + courseId)).data;
      return signedIn() && enrollment.status == "enrolled"
        && (enrollment.accessType == "free" || (enrollment.expiresAt != null && request.time < enrollment.expiresAt));
    }

    match /users/{userId} {
      allow create: if isOwner(userId);
      allow read, update: if isOwner(userId) || isAdmin();
      allow delete: if false;

      match /fcmTokens/{token} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /events/{eventId} {
      // A registered learner must retain access to a cancelled session's details and refund notice.
      allow read: if resource.data.status == "active" || isAdmin() || isRegisteredForEvent(eventId);
      allow create, update, delete: if isAdmin();
    }

    match /eventRegistrations/{registrationId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAdmin()
        || (signedIn() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /complaints/{complaintId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if false;
    }

    match /courses/{courseId} {
      allow read: if resource.data.status == "published" || isAdmin() || isEnrolledInCourse(courseId);
      allow create, update, delete: if isAdmin();

      match /lessons/{lessonId} {
        allow read: if isAdmin() || hasActiveCourseAccess(courseId);
        allow create, update, delete: if isAdmin();
      }
    }

    match /courseEnrollments/{enrollmentId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.courseId is string
        && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.accessType == "free"
        && request.resource.data.accessType == "free"
        && request.resource.data.status == "enrolled";
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (isOwner(resource.data.userId) && resource.data.accessType == "free");
    }

    match /sitePolicies/{policyId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /siteSettings/{settingId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }
  }
}
